 {"content": "secondary_1", "type": "objective"}]}], "stimuli_ids": [], "template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": "What are the characteristics of a good computer program?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "correct_feedback": "Correct!"}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Move the words from the box to correctly complete\nthe sentences.\n", "type": "text"}]}]}, {"id": 10, "type": "RSLT", "questions": [{"id": 0, "responses": [{"selected": 0, "id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}]}, {"selected": 0, "id": 1, "correct": 1, "_data": [{"content": "", "type": "text"}]}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}], "stimuli_ids": [], "template_override": 1, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "correct_feedback": "Correct!"}, "type": "feedback"}]}, {"id": 11, "type": "DWS", "questions": [{"id": 0, "responses": [{"selected": 0, "id": 0, "correct": 1, "_data": [{"content": "", "type": "text"}]}], "_data": [{"type": "question", "contents": [{"content": "enpe7n2le01ob01re7pdf01.pdf", "type": "pdf"}]}]}], "stimuli_ids": [], "template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": "It's your turn to find the most common computer programs used today. ", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "correct_feedback": "Correct!"}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}]}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "", "type": "lesson_name"}, {"content": "What Is a Computer Program?", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 1, "type": "lesson"}, {"content": "A1.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about computer programs.", "type": "text"}]}, {"type": "objectives", "contents": [{"content": "Understand key information about the concepts, principles, and methodologies in simple spoken and written situations.  Talk about programming techniques, use cases, kinds, and sequences in simple spoken and written situations.", "type": "primary"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures.  Identifies general aspects related to Software Programming in short written or spoken conversations about past experiences.", "type": "secondary_1"}]}, {"content": "enpe7n2le01ob01re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "The Simple Present Tense", "type": "heading"}, {"content": "There is one common tense in English you use to talk about the present in general, it's called <span class=\"strong\">simple present</span>.", "type": "describer"}, {"content": "You can use the <span class=\"strong\">simple present</span> when you talk about habits or routines, permanent situations, and scientific facts that have always the same result. </br> </br>  Example: <span class=\"italic\">I always <strong>buy</strong> Apple products.</span> </br>               <span class=\"italic\"> She <strong>designs</strong> software for a big company. </span></br></br>  We usually use the <span class=\"strong\">simple present</span> with frequency adverbs because habits and routines imply frequency. </span></br></br>Example</br><span class=\"italic\">I <span class=\"strong\">usually write</span> a report every Monday.</span></br></br>Notice how the verbs always keep their base form in interrogative and negative statements. </br></br>Example: </br><span class=\"italic\"><span class=\"strong\">Does</span> Mary <span class=\"strong\">find</span> new errors in the software testing?</span></br></br>Notice that when we have affirmative statements, we add <strong>-s</strong> to the verbs in third person singular.</br> Examples:</br><span class=\"italic\"><i> <strong>She</strong> design<strong>s</strong> software for a big company.</span> </i></br><span class=\"italic\"><i><strong>He</strong> sell<span class=\"strong\">s</span> software.</i></span></br></br>There are certain rules for adding -s: When the verb ends in <strong>consonant + y</strong>: Eliminate -y and add <strong>-ies</strong>. </br>Example: <i>He tr<strong>ies</strong> to design a new app.</i>   </br> When the verb ends in <strong>vowel + y</strong> , you only add <strong>-s</strong>. </br>Example: </br><i>He buy<strong>s</strong> the latest software.</i></br> When verbs end in <strong>-sh</strong>, <strong>-ch</strong>, <strong>-z</strong>, <strong>-ss</strong>, <strong>-x</strong> : Add <strong>-es</strong>.  </br> Example: </br><i>He fix<strong>es</strong> his boss' computer. </i></br></br> In the following chart, you can see the structure of the <span class=\"strong\">present simple</span>.</br>", "type": "text"}, {"content": "{\"rows\":4,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<strong>Present Simple</strong>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Affirmative \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Negative  \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Interrogative\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I/you/we/they\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I <strong>find </strong>a new program.  You send an email.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We <strong>don't send</strong> new products.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<strong>Do</strong> they get products?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"He/she/it\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"He <strong>sells</strong> software\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"She <strong>doesn't buy </strong> software. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <strong>Does</strong> she <strong>buy</strong> a computer?\\\"}\"],\"styles\":\"\"}", "type": "table"}, {"content": "I don't understand anything about programs.", "type": "example"}, {"content": "Do you know what the usefulness of programs is?", "type": "example"}, {"content": "System software refers to the operating system that permits the software and hardware interaction and functionality. ", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "There Is, There Are in Affirmative", "type": "heading"}, {"content": "You can use <strong>there is</strong> and <strong>there are</strong> to refer to the existence of things or people. ", "type": "describer"}, {"content": "You use <strong>there is</strong> or the contraction <strong>there's</strong> for singular nouns </br></br>  For example: <span class=\"italic\">There <strong>is a </strong>computer.</span> </br>                       <span class=\"italic\"> There<strong>'s </strong>a technician. </span></br></br>  You use <strong>there are</strong> or the contraction <strong>there're</strong> for plural nouns. </br></br>  For example: <span class=\"italic\">There <strong>are some <strong>computers</strong></span>. </br> <span class=\"italic\">There <strong>'re two</strong> technicians.</span>", "type": "text"}, {"content": "Without programs the computer cannot even run, so there are system programs that permit the machine to start. ", "type": "example"}, {"content": "How many programs are there? ", "type": "example"}, {"content": "There are as many computer programs as you can imagine.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "set", "type": "name"}, {"content": "group of elements", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: A computer program is a set of instructions and rules that computers need for functioning.", "type": "example"}, {"content": "enpe7n2le01ob01aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "perform", "type": "name"}, {"content": "to do something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: There are programs to perform any possible job.", "type": "example"}, {"content": "enpe7n2le01ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "usefulness", "type": "name"}, {"content": "similar to utility", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Do you know what the usefulness of programs is?", "type": "example"}, {"content": "enpe7n2le01ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "execute ", "type": "name"}, {"content": "to complete or perform something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The machine executes those programs in the central processing unit.", "type": "example"}, {"content": "enpe7n2le01ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "application ", "type": "name"}, {"content": "program designed to fulfil a specific task", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Algorithms are the main structure of a program as they store its tasks and applications.", "type": "example"}, {"content": "enpe7n2le01ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "feature ", "type": "name"}, {"content": "a typical quality or  characteristic", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: What are their features?", "type": "example"}, {"content": "enpe7n2le01ob01aud06", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Find information about the three most common computer programs people use nowadays.  ", "type": "text"}, {"content": "Find information about their usefulness and characteristics.", "type": "text"}, {"content": "Write down your ideas, use the simple present, there is/are.", "type": "text"}, {"content": "Share your ideas about computer programs.  ", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I find information about the most common computer programs people use nowadays. ", "type": "text"}, {"content": "I find information about their usefulness and characteristics.  ", "type": "text"}, {"content": "I write down my ideas in the simple present.", "type": "text"}, {"content": "I share the information with my partners.", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "Different Types of Computer Programs", "type": "heading"}, {"content": "<p>There are two kinds of <strong>programs in computing</strong>: <strong>application</strong> programs, and <strong>system</strong> programs. The difference between those two types of programs is slight and has to do more with marketing matters than with functionality.</p> <p><strong>Application programs</strong> are the one we use to carry on our work and to fulfill our tasks; examples of applications are <strong>game programs</strong> and <strong>word processors</strong> among others.</p>", "type": "describer"}, {"content": "<p><strong>System programs</strong> are the one in charge of <strong>running the system</strong>; they ensure the functionality of the <strong>hardware</strong> and <strong>software</strong> altogether; what is more, they provide the environment for the applications to run. This is, they facilitate the hardware and software resources an application needs to run. The most important system program is the <strong>operating system</strong> which permits the computer to work.</p>", "type": "text"}]}]}